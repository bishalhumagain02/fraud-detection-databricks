# Databricks workspace connection
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<your-personal-access-token>

# Unity Catalog Volume path used as the simulator's landing zone
UC_VOLUME_PATH=/Volumes/fraud_project/raw/landing

# Local path to the PaySim CSV (not committed)
PAYSIM_CSV_PATH=data/raw/paysim.csv

# Simulator pacing
BATCH_SIZE=200
BATCH_INTERVAL_SECONDS=30
